# Template of paths.env: copy it to paths.env (git-ignored) and set DATA_ROOT, or any other location, to your system:
#   cp paths.env.example paths.env
# Locations of the data outside this repository, read by the notebooks and scripts (utrals.paths) and by the pipeline
# (pipeline/config.sh). DATA_ROOT is the only absolute path of the repository; every other location is relative to it.
# Each variable can be overridden by exporting it before running, e.g. PROJECT_DIR=/my/scratch (the variables defined
# from it then follow). Format: one KEY=VALUE per line, ${KEY} refers to a variable defined above, # starts a comment line.

# Root of the data storage: the only absolute path, to set to your system (on the Luisier lab storage: its root)
DATA_ROOT=/path/to/data_root

# Results, one folder per dataset (written by the pipeline, read by the notebooks)
PROJECT_DIR=${DATA_ROOT}/projects/ALS_Comp

# Raw FASTQ files
DATABASE_DIR=${DATA_ROOT}/database

# Genome annotations and indices, CLIP and RNA-modification sites
GENOMICS_DIR=${DATA_ROOT}/group/genomics
ANNOT_DIR=${GENOMICS_DIR}/annotation/hg38
CLIP_DIR=${GENOMICS_DIR}/CLIP/hg38
RMBASE_DIR=${ANNOT_DIR}/RMBase

# Reference tables read by the notebooks, kept in the project folder: proteomics of the MN differentiation (GSE152983)
# and the AxonLoc supplementary tables (condensate propensity; an Excel workbook despite its .csv name)
PROTEOMICS_CSV=${PROJECT_DIR}/MN_diff/data/Proteomics/GSE152983_Proteomics_Col_Median_Norm_Renamed.csv
AXONLOC_CSV=${PROJECT_DIR}/AxonLoc/Supplementary_tables.csv

# Raw processing (FASTQ, STAR, kallisto, featureCounts) of the ENCODE knockdowns: <cell line>_shRNA/
EXTERNAL_DATA_DIR=${DATA_ROOT}/ENCODE_KD/

# Clones of the apatools and bulkanalysis repositories, whose scripts the pipeline runs (pipeline/setup_external_repos.sh)
REPOS_DIR=${DATA_ROOT}/temp/repositories/
